{
  "name": "arrange_widgets",
  "title": "Arrange widgets",
  "description": "Moves and resizes several widgets at once on the 12-column grid.",
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "widgets": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "col": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11,
              "description": "Grid column (12-column grid, 0 = left)."
            },
            "row": {
              "type": "integer",
              "minimum": 0,
              "description": "Grid row (0 = top)."
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "description": "Width in grid columns (12 = full width, 6 = half)."
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "description": "Height in grid rows."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "widgets"
    ],
    "additionalProperties": false
  }
}
